        // Toast Notification System
        function showToast(message, type = 'error') {
            const toast = document.createElement('div');
            const bgColor = type === 'error' ? 'bg-red-500/90' : 'bg-emerald-500/90';
            const icon = type === 'error' ? 'fa-circle-exclamation' : 'fa-circle-check';
            
            toast.className = `${bgColor} text-white px-4 py-3 rounded-lg shadow-lg flex items-center space-x-3 transform transition-all duration-300 translate-x-full`;
            toast.innerHTML = `
                <i class="fa-solid ${icon}"></i>
                <span class="text-sm font-medium">${message}</span>
            `;
            
            toastContainer.appendChild(toast);
            
            // Animate in
            requestAnimationFrame(() => {
                toast.classList.remove('translate-x-full');
            });
            
            // Remove after 3 seconds
            setTimeout(() => {
                toast.classList.add('translate-x-full', 'opacity-0');
                setTimeout(() => toast.remove(), 300);
            }, 3000);
        }

        // Character counter
        promptInput.addEventListener('input', () => {
            charCount.textContent = promptInput.value.length;
        });

        // Update line numbers
        function updateLineNumbers() {
            const text = codeDisplay.textContent;
            const lines = text.split('\n').length;
            lineCountSpan.textContent = lines;
            codeStats.classList.remove('hidden');
            
            let html = '';
            for (let i = 1; i <= lines; i++) {
                html += `<span class="text-xs font-mono text-slate-600 leading-relaxed block">${i}</span>`;
            }
            lineNumbers.innerHTML = html;
