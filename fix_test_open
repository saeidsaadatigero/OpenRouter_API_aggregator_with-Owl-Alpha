            e.preventDefault();
            
            const filename = document.getElementById('filename').value.trim();
            const prompt = promptInput.value.trim();
            
            // Client-side validation
            if (!filename || !prompt) {
                showToast('Please fill in all required fields.');
                return;
            }
            
            if (filename.includes('..') || filename.includes('~')) {
                showToast('Invalid filename. Path traversal detected.');
                return;
            }
            
            submitBtn.disabled = true;
            loaderState.classList.remove('hidden');
            loaderState.classList.add('flex');

            const formData = new FormData(form);
            
            try {
                const response = await fetch('/api/generate', { 
                    method: 'POST', 
                    body: formData,
                    signal: AbortSignal.timeout(60000) // 60 second timeout
                });
                
                const data = await response.json();
                
                if (response.ok) {
                    // Update main panel
                    codeDisplay.textContent = data.generated_code;
                    currentActiveBuffer = data.generated_code;
                    updateLineNumbers();
                    
                    // Inject fresh card to sidebar pipeline stack
                    const freshCard = document.createElement('div');
                    freshCard.id = `card-${data.id}`;
                    freshCard.dataset.id = data.id;
                    freshCard.className = "history-card p-4 bg-slate-900/40 border border-cyan-500/40 rounded-xl cursor-pointer transition relative group shadow-sm";
                    freshCard.innerHTML = `
                        <div class="flex justify-between items-start mb-2">
                            <span class="text-xs font-mono text-cyan-400 truncate max-w-[180px]"><i class="fa-solid fa-file-invoice-dollar text-slate-500 mr-1"></i>${escapeHtml(data.filename)}</span>
                            <span class="text-[10px] text-slate-500 font-mono">Just Now</span>
                        </div>
                        <p class="text-xs text-slate-300 line-clamp-2 pr-4 font-sans">${escapeHtml(data.prompt)}</p>
                        <textarea class="hidden" id="raw-${data.id}">${escapeHtml(data.generated_code)}</textarea>
                    `;
                    
                    // Add click event listener
                    freshCard.addEventListener('click', () => displayCode(data.id));
                    
                    historyContainer.insertBefore(freshCard, historyContainer.firstChild);
                    form.reset();
                    charCount.textContent = '0';
                    
                    showToast('Code generated successfully!', 'success');
                } else {
                    showToast(data.detail || 'Error processing cluster request');
                }
            } catch (err) {
                if (err.name === 'TimeoutError') {
                    showToast('Request timed out. Please try again.');
                } else {
                    showToast('Network error: ' + err.message);
                }
            } finally {
                submitBtn.disabled = false;
                loaderState.classList.add('hidden');
                loaderState.classList.remove('flex');
            }
        });

        // Display code from history
        function displayCode(id) {
            document.querySelectorAll('.history-card').forEach(c => {
                c.classList.remove('border-cyan-500/50', 'bg-slate-900/80');
            });
            
            const selectedCard = document.getElementById(`card-${id}`);
            if (selectedCard) {
                selectedCard.classList.add('border-cyan-500/50', 'bg-slate-900/80');
            }
            
            const rawCode = document.getElementById(`raw-${id}`).value;
            codeDisplay.textContent = rawCode;
            currentActiveBuffer = rawCode;
            updateLineNumbers();
        }

        // Add event listeners to existing history cards
        document.querySelectorAll('.history-card').forEach(card => {
            card.addEventListener('click', () => {
                const id = card.dataset.id;
                if (id) displayCode(id);
            });
        });

        // Copy button
        copyBtn.addEventListener('click', async () => {
            if (!currentActiveBuffer) {
                showToast('No code to copy. Generate or select code first.');
                return;
            }
            
            try {
                await navigator.clipboard.writeText(currentActiveBuffer);
                copyBtn.innerHTML = "<i class='fa-solid fa-check text-emerald-400'></i> <span class='text-emerald-400'>Copied!</span>";
                setTimeout(() => {
                    copyBtn.innerHTML = "<i class='fa-regular fa-copy'></i> <span>Copy Raw Buffer</span>";
                }, 2000);
            } catch (err) {
                showToast('Failed to copy to clipboard');
            }
        });

        // Escape HTML to prevent XSS
        function escapeHtml(text) {
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }
    </script>
