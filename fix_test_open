import os
import logging
from pathlib import Path
from fastapi import FastAPI, Request, Depends, HTTPException, Form
from fastapi.responses import HTMLResponse, JSONResponse
from fastapi.staticfiles import StaticFiles
from fastapi.templating import Jinja2Templates
from fastapi.middleware.cors import CORSMiddleware
from sqlalchemy.orm import Session
from typing import List

import models
import schemas
from database import engine, get_db
from services.openrouter_service import OpenRouterCodingService

# Configure logging
logging.basicConfig(level=logging.INFO)
logger = logging.getLogger(__name__)

# Build tables
models.Base.metadata.create_all(bind=engine)

app = FastAPI(title="OpenRouter Studio Core")

# CORS middleware
app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)

app.mount("/static", StaticFiles(directory="static"), name="static")
templates = Jinja2Templates(directory="templates")
coder_service = OpenRouterCodingService()

# Constants
MAX_PROMPT_LENGTH = 5000
MAX_FILENAME_LENGTH = 255
ALLOWED_EXTENSIONS = {'.py', '.js', '.ts', '.java', '.cpp', '.c', '.h', '.cs', '.go', '.rs'}


def validate_filename(filename: str) -> bool:
    """Validate filename to prevent path traversal and ensure safe extensions."""
    if not filename or len(filename) > MAX_FILENAME_LENGTH:
        return False
    
    # Check for path traversal attempts
    if '..' in filename or '~' in filename or filename.startswith('/'):
        return False
    
    # Check extension
    ext = Path(filename).suffix.lower()
    if ext not in ALLOWED_EXTENSIONS:
        return False
    
    return True


@app.get("/", response_class=HTMLResponse)
async def index_view(request: Request, db: Session = Depends(get_db)):
    history = db.query(models.GenerationHistory).order_by(
        models.GenerationHistory.created_at.desc()
    ).all()
    return templates.TemplateResponse(
        request=request,
        name="index.html",
        context={"history": history}
    )


@app.post("/api/generate")
async def handle_generation(
    prompt: str = Form(...),
    filename: str = Form(...),
    db: Session = Depends(get_db)
):
    # Validation
    if not prompt.strip() or not filename.strip():
        raise HTTPException(status_code=400, detail="Required fields are empty.")
    
    if len(prompt) > MAX_PROMPT_LENGTH:
        raise HTTPException(status_code=400, detail=f"Prompt exceeds maximum length of {MAX_PROMPT_LENGTH} characters.")
    
    if not validate_filename(filename):
        raise HTTPException(status_code=400, detail="Invalid filename. Use safe paths with allowed extensions.")
    
    try:
        raw_code = coder_service.generate_code(prompt=prompt)
        
        if not raw_code:
            raise HTTPException(status_code=500, detail="No code was generated.")
        
        # Save file safely
        safe_path = Path(filename).resolve()
        os.makedirs(safe_path.parent if safe_path.parent != Path('.') else '.', exist_ok=True)
        
        with open(safe_path, "w", encoding="utf-8") as f:
            f.write(raw_code)
        
        # Save to database
        history_entry = models.GenerationHistory(
            prompt=prompt[:500],  # Truncate for storage
            generated_code=raw_code,
            filename=filename
        )
        db.add(history_entry)
        db.commit()
        db.refresh(history_entry)
        
        logger.info(f"Generated code for {filename}, id={history_entry.id}")
        
        return {
            "id": history_entry.id,
            "prompt": history_entry.prompt,
            "filename": history_entry.filename,
            "generated_code": history_entry.generated_code,
            "created_at": history_entry.created_at.strftime("%Y-%m-%d %H:%M:%S")
        }
        
    except HTTPException:
        raise
    except Exception as e:
        db.rollback()
        logger.error(f"Generation error: {str(e)}")
        return JSONResponse(
            status_code=500,
            content={"detail": f"Internal server error: {str(e)}"}
        )


